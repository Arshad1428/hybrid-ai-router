# ---- Routing ----
DEFAULT_PROVIDER=local          # local | cloud
AWS_CLOUD_ENABLED=false         # must be true before ANY Bedrock call is made

# ---- Local (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b        # any model you have pulled with `ollama pull`
OLLAMA_TIMEOUT_SECONDS=120

# ---- AWS Bedrock (on-demand only) ----
AWS_REGION=us-east-1            # pick ONE region and stay in it
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0   # one cheap text model; verify it is available in your region
# AWS_PROFILE=hybrid-router     # optional: named profile in ~/.aws/credentials (never put keys here)

# ---- Cost guards ----
MAX_OUTPUT_TOKENS=256
MAX_CLOUD_CALLS_PER_SESSION=5
